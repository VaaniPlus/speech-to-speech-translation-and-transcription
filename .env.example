# Local development configuration. Copy this file to .env to override defaults.
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

STT_MODEL_ID=Systran/faster-whisper-small
STT_COMPUTE_TYPE=auto
TRANSLATION_EN_HI_MODEL_ID=ai4bharat/indictrans2-en-indic-dist-200M
TRANSLATION_HI_EN_MODEL_ID=ai4bharat/indictrans2-indic-en-dist-200M
TTS_EN_MODEL_ID=hexgrad/Kokoro-82M
TTS_HI_MODEL_ID=hexgrad/Kokoro-82M
MODEL_CACHE_DIR=models
DEVICE=auto
MAX_UPLOAD_SIZE_BYTES=26214400
PROVIDER_TIMEOUT_SECONDS=120
PROVIDER_MODE=mock
