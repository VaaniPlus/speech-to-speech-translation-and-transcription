# Local development configuration. Copy this file to .env to override defaults.
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

STT_MODEL_ID=Systran/faster-whisper-small
STT_COMPUTE_TYPE=int8
TTS_EN_MODEL_ID=hexgrad/Kokoro-82M
TTS_HI_MODEL_ID=hexgrad/Kokoro-82M
MODEL_CACHE_DIR=models
DEVICE=cpu
MAX_UPLOAD_SIZE_BYTES=26214400
PROVIDER_TIMEOUT_SECONDS=300
PROVIDER_MODE=real
DATABASE_URL=postgresql+psycopg://vaaniplus:vaaniplus@127.0.0.1:5432/vaaniplus
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=60
SEED_DEFAULT_USER=true
DEFAULT_USER_EMAIL=proindra@example.com
DEFAULT_USER_PASSWORD=VaaniProindra#2026
